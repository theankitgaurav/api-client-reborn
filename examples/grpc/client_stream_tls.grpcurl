# @name gRPC Streaming Input (TLS, Client Stream)
# @description Sends multiple payloads to Google's gRPC interoperability server and receives their total size.
# @timeout 30000

printf '%s\n' '{"payload":{"body":"aGVsbG8="}}' '{"payload":{"body":"d29ybGQ="}}' | grpcurl \
  -import-path 'examples/grpc' \
  -proto 'interop.proto' \
  -d @ \
  '{{grpc_interop_host}}:{{grpc_interop_port}}' \
  'grpc.testing.TestService/StreamingInputCall'
