# @name gRPC Converse (TLS, Bidirectional Stream)
# @description Exchanges multiple messages with ConnectRPC over a verified TLS bidirectional stream.
# @timeout 30000

printf '%s\n' '{"sentence":"Hello there"}' '{"sentence":"Testing the stream"}' | grpcurl \
  -d @ \
  '{{grpc_host}}:{{grpc_port}}' \
  'connectrpc.eliza.v1.ElizaService/Converse'
