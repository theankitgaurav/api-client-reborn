# @name gRPC Say (TLS, Local Proto)
# @description Calls ConnectRPC's public ElizaService using the bundled proto file.
# @timeout 30000

grpcurl \
  -import-path 'examples/grpc' \
  -proto 'eliza.proto' \
  -d '{"sentence": "Hello local proto"}' \
  '{{grpc_host}}:{{grpc_port}}' \
  'connectrpc.eliza.v1.ElizaService/Say'
