# @name gRPC Metadata (TLS, Local Proto)
# @description Sends metadata to Google's gRPC interoperability server and inspects its echoed response headers.
# @timeout 30000

grpcurl \
  -import-path 'examples/grpc' \
  -proto 'interop.proto' \
  -H 'x-grpc-test-echo-initial: api-client-reborn' \
  -d '{}' \
  '{{grpc_interop_host}}:{{grpc_interop_port}}' \
  'grpc.testing.TestService/UnaryCall'
