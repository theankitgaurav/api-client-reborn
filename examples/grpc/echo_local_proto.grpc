{
  "name": "gRPC Echo (Local Proto, No Reflection)",
  "endpoint": "http://127.0.0.1:50051",
  "service": "demo.DemoService",
  "method": "Echo",
  "request_json": "{\n  \"message\": \"hello without reflection\",\n  \"count\": 1\n}",
  "metadata": [],
  "proto_file": "examples/grpc/demo.proto",
  "use_reflection": false,
  "tls_enabled": false,
  "tls_insecure": false,
  "tls_ca_file": null,
  "timeout_ms": 30000
}
