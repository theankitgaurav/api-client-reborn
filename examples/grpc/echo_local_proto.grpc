{
  "name": "gRPC Say Hello (Local Proto, Unary)",
  "endpoint": "grpc.postman-echo.com:443",
  "service": "HelloService",
  "method": "SayHello",
  "request_json": "{\n  \"greeting\": \"Hello from a local proto file\"\n}",
  "metadata": [],
  "proto_file": "examples/grpc/hello.proto",
  "use_reflection": false,
  "tls_enabled": false,
  "tls_insecure": false,
  "tls_ca_file": null,
  "timeout_ms": 30000
}
