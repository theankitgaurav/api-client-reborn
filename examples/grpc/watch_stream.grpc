{
  "name": "gRPC Lots of Replies (Server Stream, Spooled)",
  "endpoint": "grpc.postman-echo.com:443",
  "service": "HelloService",
  "method": "LotsOfReplies",
  "request_json": "{\n  \"greeting\": \"Send several replies so the client can spool the stream\"\n}",
  "metadata": [],
  "proto_file": "examples/grpc/hello.proto",
  "use_reflection": false,
  "tls_enabled": false,
  "tls_insecure": false,
  "tls_ca_file": null,
  "timeout_ms": 60000
}
