{
  "name": "gRPC Say Hello (Reflection, Unary, Variables)",
  "endpoint": "grpc.postman-echo.com:443",
  "service": "HelloService",
  "method": "SayHello",
  "request_json": "{\n  \"greeting\": \"Hello {{tenant_id}} from API Client Reborn\"\n}",
  "metadata": [],
  "proto_file": null,
  "use_reflection": true,
  "tls_enabled": false,
  "tls_insecure": false,
  "tls_ca_file": null,
  "timeout_ms": 30000
}
