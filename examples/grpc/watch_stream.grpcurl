# @name gRPC Introduce (TLS, Local Proto, Server Stream)
# @description Receives server-streamed replies from ConnectRPC using the bundled proto file.
# @timeout 30000

grpcurl \
  -import-path 'examples/grpc' \
  -proto 'eliza.proto' \
  -d '{"name": "API Client Reborn"}' \
  '{{grpc_host}}:{{grpc_port}}' \
  'connectrpc.eliza.v1.ElizaService/Introduce'
